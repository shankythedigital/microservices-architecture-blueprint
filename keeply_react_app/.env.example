# Optional overrides when not using the Vite dev proxy (e.g. production or Postman parity).
# Leave unset during `npm run dev` so `/api/*` is proxied to the correct ports.

# Match backend application.yml (used by Vite dev server proxy targets):
# HELPDESK_SERVICE_PORT=8086

# VITE_AUTH_BASE=http://localhost:8081
# VITE_ASSET_BASE=http://localhost:8085
# VITE_NOTIFICATION_BASE=http://localhost:8082
# VITE_HELPDESK_BASE=http://localhost:8084

# Capacitor / APK builds use `--mode capacitor` and read `.env.capacitor` (see that file for remote host).
# Override without editing the repo: create `.env.capacitor.local` with the same variable names.
#
# If the UI is loaded over HTTPS but APIs are http:// only, set true to skip auto-upgrading bases to https://:
# VITE_ALLOW_INSECURE_HTTP_API=true
#
# Debug which URLs the app calls (Chrome remote-debug the WebView → Console):
# VITE_DEBUG_API=true
