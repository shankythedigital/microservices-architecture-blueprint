# Loaded only for `npm run build:mobile` (--mode capacitor).
# Default: same ports as local Spring services; if you use nginx on :80 only, set every base to http://194.163.173.37

# Keep http:// API URLs (Capacitor mode already does; set on web preview if needed).
VITE_ALLOW_INSECURE_HTTP_API=true

VITE_AUTH_BASE=http://localhost:7071
VITE_ASSET_BASE=http://localhost:7075
VITE_NOTIFICATION_BASE=http://localhost:7072
VITE_HELPDESK_BASE=http://localhost:7074

# Uncomment to log every request URL in the WebView console (use Chrome → Inspect).
# VITE_DEBUG_API=true
