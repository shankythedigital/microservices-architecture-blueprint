  "item": [
    {
      "name": "1. Send",
      "item": [
        {
          "name": "Send SMS Notification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{notificationbaseUrl}}/api/notifications",
              "host": [
                "{{notificationbaseUrl}}"
              ],
              "path": [
                "api",
                "notifications"
              ]
            },
            "description": "NotificationRequest: channel (required). Optional: username, mobile, email, subject, templateCode, placeholders/variables, userId, documentId, docType",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"SMS\",\n  \"templateCode\": \"OTP_SMS\",\n  \"recipient\": \"{{recipient}}\",\n  \"mobile\": \"{{mobile}}\",\n  \"variables\": {\n    \"otp\": \"123456\",\n    \"expiry\": \"3\",\n    \"documentId\": \"{{documentId}}\",\n    \"docType\": \"{{docType}}\"\n  },\n  \"userId\": \"{{userId}}\",\n  \"username\": \"{{username}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Send Email Notification",
          "request": {
