              "raw": "{\n  \"channel\": \"EMAIL\",\n  \"templateCode\": \"WELCOME_EMAIL\",\n  \"recipient\": \"user@example.com\",\n  \"variables\": {\n    \"name\": \"John Doe\",\n    \"activationLink\": \"https://example.com/activate\"\n  }\n}",
