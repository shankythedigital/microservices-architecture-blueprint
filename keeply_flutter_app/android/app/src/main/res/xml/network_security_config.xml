<?xml version="1.0" encoding="utf-8"?>
<!-- Allow HTTP to local microservices (emulator 10.0.2.2, adb reverse, LAN IPs via dart-define). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
